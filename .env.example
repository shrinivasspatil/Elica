# Public site URL
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_SSL=true

# Better Auth
BETTER_AUTH_SECRET=your-random-secret-here
BETTER_AUTH_URL=https://your-domain.com

# Hostinger SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@elicservicecenter.com
SMTP_PASS=your-email-password
NOTIFY_EMAIL=srini.spatil@gmail.com

# On Hostinger, set SMTP_PASS with a leading backslash before $ if the password starts with $
# Example: SMTP_PASS=\$yourPassword
