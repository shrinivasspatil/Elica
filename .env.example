NEXT_PUBLIC_SITE_URL=https://elicservicecenter.com

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_SSL=true

# Better Auth
BETTER_AUTH_SECRET=your-random-secret-here
BETTER_AUTH_URL=https://elicservicecenter.com

# Hostinger SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@elicservicecenter.com
# Prefer SMTP_PASS_B64 on Hostinger so $ in the password is not mangled
# Generate with: printf '%s' 'your-password' | base64
SMTP_PASS_B64=
# Or raw password (escape $ as \$ in .env files):
# SMTP_PASS=\$yourPassword
# Use SEPARATE env vars on Hostinger (comma in one value is often truncated)
NOTIFY_EMAIL=srini.spatil@gmail.com
NOTIFY_EMAIL_2=sietravi@gmail.com

